# Sparky edge configuration (#25). Lives at /etc/sparky/edge.env inside the
# sparky-host WSL distro; `setup-host.sh engine` creates it from this file.
# Host-owned device configuration: never baked into images (SECURITY.md).
# No secrets belong here; secrets stay in backend.env/microservice.env in the
# sparky-data volume.

# --- Images (digest-pinned) -----------------------------------------------
# Edge containers (proxy + orchestrator). Changed only by `upgrade-edge`.
SPARKY_EDGE_IMAGE=ghcr.io/jdmasuta/sparky-app@sha256:REPLACE_WITH_RELEASE_DIGEST
# App image used only for the very first start; afterwards the orchestrator
# tracks the active version itself.
SPARKY_APP_IMAGE=ghcr.io/jdmasuta/sparky-app@sha256:REPLACE_WITH_RELEASE_DIGEST
# Updates are accepted only from this image repository and release repo.
SPARKY_IMAGE_REPO=ghcr.io/jdmasuta/sparky-app
SPARKY_RELEASE_REPO=JdMasuta/Sparky-App
# Optional https: or file: manifest instead of the GitHub latest release
# (offline installs, device testing). Leave empty normally.
SPARKY_UPDATE_MANIFEST_URL=

# --- Time and update policy -----------------------------------------------------
# Device IANA time zone; filled from Windows (via WSL) by setup-host.sh.
SPARKY_TZ=
# Updates run only inside this local-time window; outside it they queue.
SPARKY_UPDATE_WINDOW=17:00-03:00
# Wait this long for in-flight checkouts, then postpone (10 min).
SPARKY_DRAIN_TIMEOUT_MS=600000

# --- Network and host ----------------------------------------------------------
# Address/port the proxy publishes on the WSL host (reach it from the LAN via
# mirrored networking or portproxy; see README).
SPARKY_BIND_ADDR=0.0.0.0
SPARKY_HTTP_PORT=3000
# Daily DB backups land here (C:\SparkyData\backups on Windows).
SPARKY_BACKUP_HOST_DIR=/mnt/c/SparkyData/backups
# Group owning /var/run/docker.sock; filled by setup-host.sh.
DOCKER_GID=
# Container subnets; change only if they collide with plant networks.
SPARKY_PUBLIC_SUBNET=172.30.0.0/24
SPARKY_FRONT_SUBNET=172.30.1.0/24
SPARKY_CONTROL_SUBNET=172.30.2.0/24
SPARKY_ORCH_EGRESS_SUBNET=172.30.3.0/24
SPARKY_APP_EGRESS_SUBNET=172.30.4.0/24
