# Edge config for local/CI tests on a Linux Docker host (#25). Not for devices.
SPARKY_EDGE_IMAGE=sparky-app:dev
SPARKY_APP_IMAGE=sparky-app:dev
SPARKY_IMAGE_REPO=localhost:5000/sparky-app
SPARKY_RELEASE_REPO=JdMasuta/Sparky-App
SPARKY_UPDATE_MANIFEST_URL=
SPARKY_TZ=UTC
SPARKY_UPDATE_WINDOW=17:00-03:00
SPARKY_DRAIN_TIMEOUT_MS=600000
SPARKY_BIND_ADDR=127.0.0.1
SPARKY_HTTP_PORT=3930
SPARKY_BACKUP_HOST_DIR=/tmp/sparky-test-backups
DOCKER_GID=
SPARKY_PUBLIC_SUBNET=172.30.0.0/24
SPARKY_FRONT_SUBNET=172.30.1.0/24
SPARKY_CONTROL_SUBNET=172.30.2.0/24
SPARKY_ORCH_EGRESS_SUBNET=172.30.3.0/24
SPARKY_APP_EGRESS_SUBNET=172.30.4.0/24
