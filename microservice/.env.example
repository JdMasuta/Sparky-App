# PLC bridge microservice environment.
# Copy to microservice/.env for standalone runs, or rely on the process env set
# by the launch scripts. The bridge binds to loopback and is only called by the
# backend on the same host.

# sim = behavioral virtual PLC (no hardware); real = live EtherNet/IP
PLC_MODE=sim

# Bind address/port (keep loopback in production)
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8000

# Shared secret the backend must present (X-Bridge-Token). Empty disables it.
BRIDGE_TOKEN=

# --- real driver (PLC_MODE=real) ---
PLC_IP=192.168.1.70
PLC_SLOT=0
PLC_TIMEOUT_MS=5000

# --- simulator (PLC_MODE=sim) ---
# Auto-start a pull ~2s after the operator reaches step 4 (hands-free demo).
SIM_AUTO_PULL=false
SIM_AUTO_PULL_DELAY_MS=2000
SIM_DEFAULT_TARGET=100
SIM_DEFAULT_RATE=10
SIM_TICK_MS=100
