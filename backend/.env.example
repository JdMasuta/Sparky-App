# Sparky Cart backend environment (v3.0.0)
#
# Copy to  %SPARKY_DATA_DIR%\.env  (default: <repo>\data\.env) on the edge device,
# or to backend/.env for local development. NEVER commit a filled-in .env.

# --- Data directory -------------------------------------------------------
# Absolute path where the SQLite DB, .env, and logs live. Kept outside release
# dirs so the updater never overwrites data. Defaults to <repo>/data if unset.
SPARKY_DATA_DIR=

# --- Runtime --------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Admin authentication -------------------------------------------------
# Generate the hash with:  node backend/scripts/hash-password.js <password>
# (scrypt; the plaintext password is never stored).
ADMIN_PASSWORD_HASH=
# Random 32+ byte hex string used to sign session cookies.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- PLC bridge microservice ----------------------------------------------
# sim  = behavioral virtual PLC (no hardware, used in dev/CI)
# real = live EtherNet/IP connection to the ControlLogix PLC
PLC_MODE=sim
PLC_IP=192.168.1.70
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8000
# Shared secret between the backend and the microservice (defense-in-depth on
# top of the loopback bind). Generate like SESSION_SECRET above.
BRIDGE_TOKEN=

# --- Email (weekly report) ------------------------------------------------
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM="Cable Audit System"
